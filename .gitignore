# --- Node ---
node_modules/

# --- Generated vendor surfaces (regenerated by `agentkit sync`) ---
# This distribution repository keeps derived mirrors local; consumer projects
# should commit their generated surfaces as described in governance/mirror-contract.md.
.claude/
.agents/
.gemini/
.codex/
.opencode/

# --- Local tool state ---
.orchestrator.lock
.fallow/
.tmp-test/

# --- Local sync state for this distribution repository ---
# Consumer projects commit their lockfile; this repository keeps its own state local.
.agentkit.lock

# =============================================================================
# Personal / fleet-local content — kept on disk for local use, NOT published.
# Copy your real versions in after cloning; they stay untracked so the public
# surface is the generic kit only. Templates ship as *.example alongside.
# =============================================================================

# Local MCP server config (contains machine-specific binary path).
.mcp.json

# Fleet roster (real project names + paths). Template: fleet.example.json.
fleet.json

# CLI-generated rollups (name real projects).
reports/
flowback-queue.json

# Personal program narrative / ticket state.
docs/working/*
!docs/working/README.md
docs/backlog/*
!docs/backlog/README.md
docs/archive/*
!docs/archive/README.md

# Personal knowledge base (product specs, persona research, prompt corpora).
docs/knowledge-base/*
!docs/knowledge-base/README.md

# Personal research drops (the kit ships only the doc-tree convention; raw
# research is a peer store kept locally).
docs/raw-research/*
!docs/raw-research/README.md

# Personal changelog fragments (the rolling CHANGELOG is committed; the in-flight
# wave fragments are local coordination state).
changelog.d/*.md
!changelog.d/README.md

# External / copyrighted source material never belongs in the public repo.
ai-advantage/
